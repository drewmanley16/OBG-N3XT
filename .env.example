# Optional: without a key, the agent uses built-in rules.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# How the patient's Ledger is reached:
#   speculos  (default) Ledger's emulator, started with `npm run speculos`
#   webhid    a real Ledger over USB (Chrome/Edge)
#   simulated no device at all; the server signs with a dev key
# NEXT_PUBLIC_LEDGER_TRANSPORT=speculos
# NEXT_PUBLIC_SPECULOS_URL=http://localhost:5005
# DEV_SIGNER_KEY=
